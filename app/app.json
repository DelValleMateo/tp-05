{
  "expo": {
    "name": "Network QoS Monitor",
    "slug": "network-qos-monitor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ar.edu.uader.qosmonitor",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Se usa la ubicación para georreferenciar cada medición de red.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Se usa la ubicación para georreferenciar las mediciones en segundo plano.",
        "UIBackgroundModes": ["fetch", "processing"],
        "NSAppTransportSecurity": { "NSAllowsArbitraryLoads": true }
      }
    },
    "android": {
      "package": "ar.edu.uader.qosmonitor",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "READ_PHONE_STATE"],
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": ["expo-sqlite", "expo-sharing", "expo-background-task"]
  }
}
